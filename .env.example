# Public values are embedded in the static site. Never put credentials here.
# Leave integrations blank until the real service has been verified by its owner.
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_CONTACT_EMAIL=
PUBLIC_ANALYTICS_ENDPOINT=
PUBLIC_OWNER_NAME=
PUBLIC_OWNER_BIO=
PUBLIC_SITE_URL=
# Locally use /; GitHub Pages builds explicitly use /Vetomin/.
PUBLIC_BASE_PATH=/
PUBLIC_FEATURE_WEBGL=false
