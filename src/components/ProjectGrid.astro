---
import { withBase } from '../lib/urls';
import { cases, caseKeys } from '../data/cases';
import ProjectMedia from './ProjectMedia.astro';
interface Props {filterable?:boolean;limit?:number;}
const {filterable=false,limit=3} = Astro.props;
---
{filterable && <div data-filter-controls hidden><div class="filters" role="group" aria-label="Filter projects by service"><span class="route">Service</span>{['all','strategy','identity','research','web','product'].map(v=><button class="filter-btn" type="button" data-filter={v} data-group="service" aria-pressed={String(v==='all')}>{v}</button>)}</div><p id="filter-status" class="status" role="status">3 routes found</p><p class="empty-state" data-filter-empty hidden>No projects match this selection. <button type="button" class="filter-btn" data-reset-filter>Show all projects</button></p></div>}
<div class="cards">
{caseKeys.slice(0,limit).map(slug => {const p=cases[slug]; return <a class="card" href={withBase(`projects/${slug}/`)} data-project data-service={p.services.join(',')} data-preview={p.name} data-prefetch data-tilt><div><ProjectMedia slug={slug} alt={`${p.name}: redesigned concept interface`}/><span class="route">{p.label}</span><h3>{p.name} / {p.headline}</h3><p>{p.description}</p></div><span class="arrow"><span>Explore the concept</span><span aria-hidden="true">↗</span></span></a>})}
</div>
