---
import { getCollection } from 'astro:content';
import ProjectMedia from './ProjectMedia.astro';
const { filterable=false, limit } = Astro.props;
const base=import.meta.env.BASE_URL;
const all=(await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
const projects=typeof limit==='number'?all.slice(0,limit):all;
---
{filterable && <div>
  <div class="filters" aria-label="Filter projects">
    <span class="route">Service</span>
    {['all','strategy','identity','research','web','product'].map(v=><button class="filter-btn" type="button" data-filter={v} data-group="service" aria-pressed={v==='all'?'true':'false'}>{v}</button>)}
  </div>
  <div id="filter-status" class="status" aria-live="polite"></div>
</div>}
<div class="cards">
{projects.map((p)=>{
  const slug=p.id.replace(/\.mdx?$/,'');
  return <a class="card" data-project data-preview={p.data.shortTitle} data-service={p.data.services.join(',')} data-industry={p.data.industry} data-outcome={p.data.outcome} data-prefetch data-tilt href={base+'projects/'+slug+'/'}>
    <div>
      <ProjectMedia slug={slug} alt="" class="project-visual project-media" />
      <span class="route">{p.data.services.join(' · ')} · {p.data.year}</span>
      <h3 class="project-title" style={`view-transition-name:project-title-${slug}`}>{p.data.title}</h3>
      <p>{p.data.description}</p>
    </div>
    <span class="arrow" aria-hidden="true">↗</span>
  </a>
})}
</div>