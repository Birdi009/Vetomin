---
import { getCollection } from 'astro:content';
import ProjectMedia from './ProjectMedia.astro';
import { withBase } from '../lib/site';
interface Props { filterable?:boolean; limit?:number; }
const {filterable=false,limit}=Astro.props;
const projects=(await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order).slice(0,limit);
---
{filterable && <div data-filter-tools hidden><div class="filters" role="group" aria-label="Filter projects by service"><span class="route">Service</span>{['all','strategy','identity','research','web','product'].map(value=><button class="filter-btn" type="button" data-filter={value} data-group="service" aria-pressed={value==='all'?'true':'false'}>{value}</button>)}</div><p id="filter-status" class="status small" role="status" aria-live="polite">{projects.length} routes found</p></div>}
{filterable && <noscript><p class="small muted">All concept studies are shown. Each card lists its design focus.</p></noscript>}
<div class="cards">
{projects.map(project=>{
 const slug=project.id.replace(/\.mdx?$/,''); const data=project.data;
 return <a class="card" data-project data-service={data.services.join(',')} data-study={slug} data-prefetch data-tilt href={withBase(`projects/${slug}/`)}>
  <div><ProjectMedia slug={slug} alt={`${data.shortTitle}: original concept interface`} sizes="(max-width:820px) 92vw, 30vw" transitionName={`project-media-${slug}`}/><span class="route">{data.services.join(' · ')}</span><h3>{data.title}</h3><p>{data.description}</p></div>
  <span class="card-meta"><span>Concept study · {data.year}</span><span class="arrow" aria-hidden="true">↗</span></span>
 </a>
})}
</div>
