---
import { withBase } from '../lib/urls';
interface Props { slug: string; alt?: string; class?: string; priority?: boolean; before?: boolean; }
const {slug,alt='',class:className='project-media',priority=false,before=false} = Astro.props;
const name = slug + (before ? '-before' : '');
const src = (width:number,format:string) => withBase(`media/${name}-${width}.${format}`);
---
<picture class={className}>
  <source type="image/avif" srcset={`${src(640,'avif')} 640w, ${src(1280,'avif')} 1280w`} sizes="(max-width: 820px) 92vw, 50vw" />
  <source type="image/webp" srcset={`${src(640,'webp')} 640w, ${src(1280,'webp')} 1280w`} sizes="(max-width: 820px) 92vw, 50vw" />
  <img src={src(1280,'webp')} width="1280" height="960" loading={priority?'eager':'lazy'} fetchpriority={priority?'high':'auto'} decoding="async" alt={alt} />
</picture>
