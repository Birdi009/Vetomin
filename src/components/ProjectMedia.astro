---
import { withBase } from '../lib/site';
interface Props { slug:string; variant?:string; alt?:string; class?:string; priority?:boolean; sizes?:string; transitionName?:string; }
const {slug,variant='after',alt='',class:className='project-media',priority=false,sizes='(max-width: 820px) 92vw, 48vw',transitionName} = Astro.props;
const image=(width:number,format:string)=>withBase(`media/${slug}-${variant}-${width}.${format}`);
---
<picture class={className} style={transitionName?`view-transition-name:${transitionName}`:undefined}>
  <source type="image/avif" srcset={`${image(640,'avif')} 640w, ${image(1280,'avif')} 1280w`} sizes={sizes}/>
  <source type="image/webp" srcset={`${image(640,'webp')} 640w, ${image(1280,'webp')} 1280w`} sizes={sizes}/>
  <img src={image(1280,'webp')} width="1280" height="960" loading={priority?'eager':'lazy'} fetchpriority={priority?'high':'auto'} decoding="async" alt={alt}/>
</picture>
