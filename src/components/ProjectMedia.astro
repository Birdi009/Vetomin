---
const { slug, alt='', class:className='project-visual project-media' }=Astro.props;
const base=import.meta.env.BASE_URL;
const tiny='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="80" height="60"><rect width="100%" height="100%" fill="#e8e1d6"/><circle cx="24" cy="20" r="14" fill="#9bb1ad" opacity=".35"/><path d="M8 50 C24 20 42 58 72 18" fill="none" stroke="#6d7c75" opacity=".35"/></svg>`);
---
<picture class={className} style={`background-image:url("${tiny}")`}>
  <source type="image/avif" srcset={`${base}media/${slug}-640.avif 640w, ${base}media/${slug}-1280.avif 1280w`} sizes="(max-width: 820px) 92vw, 48vw" />
  <source type="image/webp" srcset={`${base}media/${slug}-640.webp 640w, ${base}media/${slug}-1280.webp 1280w`} sizes="(max-width: 820px) 92vw, 48vw" />
  <img src={base+`media/${slug}-1280.webp`} width="1280" height="960" loading="lazy" decoding="async" alt={alt} />
</picture>