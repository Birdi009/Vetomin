---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site';
import { readingMinutes } from '../lib/reading.mjs';
const articles=(await getCollection('journal')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="Journal — Quiet Compass" description="Practical essays on calm interaction, workflow decisions and reduced-motion design, with examples from the Quiet Compass concept studies." route="D04" element="wood">
 <section><div class="shell"><div class="section-head"><div><span class="route">D04 / Journal</span><h1>Questions worth<br/>staying with.</h1></div><p>Short essays with specific examples, design tradeoffs and useful next questions. The reading times are estimates calculated from each article's actual text.</p></div><div class="journal-grid">{articles.map(article=><article class="journal-card"><span class="route">{article.data.category} / About {readingMinutes(article.body||'')} min</span><h2><a href={withBase(`journal/${article.id}/`)}>{article.data.title}</a></h2><p>{article.data.description}</p><a class="text-link" href={withBase(`journal/${article.id}/`)}>Read the full essay →</a></article>)}</div></div></section>
</BaseLayout>
