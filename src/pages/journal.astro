---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
const entries=(await getCollection('journal')).sort((a,b)=>a.data.order-b.data.order);
const minutes=(body:string)=>Math.max(1,Math.ceil(body.split(/\s+/).filter(Boolean).length/220));
---
<BaseLayout title="Journal — Quiet Compass" description="Practical essays on clear workflows, meaningful interaction, and accessible design." route="D04"><section><div class="shell"><span class="route">Journal / Working notes</span><h1>Ideas you can<br/><em>put to work.</em></h1><p class="lead">Specific decisions, useful tradeoffs, and observations from the concept work. Full essays—not excerpts pretending to be articles.</p><div class="notes-grid">{entries.map(entry=><article class="note-card"><span class="route">{entry.data.category} · About {minutes(entry.body||'')} min</span><h2><a href={withBase(`journal/${entry.id.replace(/\.mdx?$/,'')}/`)}>{entry.data.title}</a></h2><p>{entry.data.description}</p><a class="text-link" href={withBase(`journal/${entry.id.replace(/\.mdx?$/,'')}/`)}>Read the essay →</a></article>)}</div></div></section></BaseLayout>
