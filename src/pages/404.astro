---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site';
---
<BaseLayout title="Page not found — Quiet Compass" description="This route is not available. Return to the Quiet Compass homepage or explore the concept studies." noindex>
 <section><div class="shell"><span class="route">404 / A missing turn</span><h1>This route<br/>is not on the map.</h1><p class="lead">The page may have moved, or the address may be incomplete. The work and the homepage are still a good place to start.</p><div class="actions"><a class="btn primary" href={withBase()}>Return home →</a><a class="btn" href={withBase('work/')}>Explore the work</a></div></div></section>
</BaseLayout>
