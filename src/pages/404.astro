---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
---
<BaseLayout title="Page not found — Quiet Compass" noindex><section><div class="shell narrow"><span class="route">404 / A different route</span><h1>This page is not here.</h1><p class="lead">The address may have changed. Your next step does not have to be a dead end.</p><div class="actions"><a class="btn primary" href={withBase()}>Go home →</a><a class="btn" href={withBase('work/')}>Browse the work</a><a class="btn" href={withBase('search/')}>Find a page</a></div></div></section></BaseLayout>
