---
import BaseLayout from '../layouts/BaseLayout.astro';
const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Route not found — Quiet Compass" description="This route does not exist." element="earth" route="404">
  <section><div class="shell" style="min-height:65vh;display:grid;place-items:center;text-align:center"><div><span class="route">404 / OFF ROUTE</span><h1>That path ends here.</h1><p>The compass still works.</p><a class="btn primary" href={base}>Return to arrival →</a></div></div></section>
</BaseLayout>