---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import Comparison from '../../components/Comparison.astro';
import SystemMap from '../../components/SystemMap.astro';
import { getStudy } from '../../lib/studies';
import { withBase, inquiryLabel } from '../../lib/site';
export async function getStaticPaths(){return (await getCollection('projects')).map(project=>({params:{slug:project.id.replace(/\.mdx?$/,'')},props:{project}}));}
const {project}=Astro.props;
const {Content}=await render(project);
const data=project.data;
const slug=project.id.replace(/\.mdx?$/,'');
const study=getStudy(slug);
const evidence=study.artifacts;
---
<BaseLayout title={`${data.title} — Quiet Compass`} description={data.description} element={data.element} route={data.route}>
 <section class="case-intro" data-element={data.element}><div class="shell"><a class="text-link small" href={withBase('work/')}>← All work</a><div class="case-grid" style="margin-top:1.5rem"><div><span class="pill">Original concept study · {data.year}</span><h1>{data.title}</h1><p class="lead">{study.question}</p></div><aside class="panel case-meta"><dl><dt>Focus</dt><dd>{data.services.join(' · ')}</dd><dt>Scope</dt><dd>{data.role}</dd><dt>Evidence status</dt><dd>Self-initiated design exercise. No client commission, user study or business outcome is claimed.</dd></dl></aside></div><nav class="case-index" aria-label="Case study sections"><a href="#story">The story</a><a href="#compare">Before & after</a><a href="#diagram">Design decisions</a><a href="#artifacts">The artifacts</a></nav><div class="project-cover" data-study={slug}><ProjectMedia slug={slug} priority alt={`${study.name}: proposed concept interface with synthetic example content`} sizes="(max-width:820px) 92vw, 1100px" transitionName={`project-media-${slug}`}/></div><p class="small muted">Original concept interface, created for this portfolio. All sample data is illustrative.</p></div></section>
 <section id="story" data-element="earth"><div class="shell case-grid"><article class="prose"><Content/></article><aside class="case-aside panel"><span class="route">Visible in the concept</span><div class="metric">{data.metric}</div><p>{data.metricLabel}</p><p class="small muted">This describes the designed artifact, not a measured improvement in speed, revenue, conversion or satisfaction.</p><a class="text-link small" href="#compare">Inspect the transformation ↓</a></aside></div></section>
 <section id="compare" data-element="metal"><div class="shell"><div class="section-head"><div><span class="route">Before / After</span><h2>Explore the<br/>actual design change.</h2></div><p>Compare two original interface concepts, then inspect the decisions that separate them. The written explanation remains available in every mode.</p></div><Comparison slug={slug}/></div></section>
 <section id="diagram" data-element="wood"><div class="shell"><div class="section-head"><div><span class="route">Decision map</span><h2>The reasoning,<br/>next to the artifact.</h2></div><p>Follow the choices specific to {study.name}. Each one connects an observation in the concept to a design decision and a visible change.</p></div><SystemMap slug={slug}/></div></section>
 <section id="artifacts" data-element={data.element}><div class="shell"><div class="section-head"><div><span class="route">Open the sketchbook</span><h2>{evidence.length} artifacts.<br/>Nothing hidden in the claim.</h2></div><p>These are original, reproducible design artifacts. Open a full-size vector to inspect the layout and labels without image compression.</p></div><div class="artifact-grid">{evidence.slice(0,4).map(item=><figure><ProjectMedia slug={slug} variant={item.key} alt={`${study.name} — ${item.title}`} sizes="(max-width:520px) 90vw, 45vw"/><figcaption><strong>{item.title}</strong>{item.caption}</figcaption><a href={withBase(`artifacts/${slug}/${item.key}.svg`)}>Open full-size {item.title.slice(5).toLowerCase()} ↗</a></figure>)}</div>{evidence.length>4&&<details><summary>Show the remaining {evidence.length-4} artifacts</summary><div class="artifact-grid">{evidence.slice(4).map(item=><figure><ProjectMedia slug={slug} variant={item.key} alt={`${study.name} — ${item.title}`} sizes="(max-width:520px) 90vw, 45vw"/><figcaption><strong>{item.title}</strong>{item.caption}</figcaption><a href={withBase(`artifacts/${slug}/${item.key}.svg`)}>Open full-size {item.title.slice(5).toLowerCase()} ↗</a></figure>)}</div></details>}</div></section>
 <section data-element="fire"><div class="shell next-action"><div><span class="route">A related question?</span><h2>{data.cta}.</h2><p class="muted">Use this study as a starting point—not a promise that the same answer fits every problem.</p></div><a class="btn primary" href={withBase(`contact/?project=${encodeURIComponent(study.name)}`)}>{inquiryLabel} →</a></div></section>
 <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Work',item:new URL(withBase('work/'),Astro.site).href},{'@type':'ListItem',position:2,name:study.name,item:new URL(Astro.url.pathname,Astro.site).href}]}).replace(/</g,'\\u003c')}/>
</BaseLayout>
