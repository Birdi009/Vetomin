---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import Comparison from '../../components/Comparison.astro';
import DecisionMap from '../../components/DecisionMap.astro';
import { getCase } from '../../data/cases';
import { withBase } from '../../lib/urls';
export async function getStaticPaths(){return (await getCollection('projects')).map(project=>({params:{slug:project.id.replace(/\.mdx?$/,'')},props:{project}}));}
const {project}=Astro.props;const slug=project.id.replace(/\.mdx?$/,'');const d=getCase(slug);const {Content}=await render(project);
---
<BaseLayout title={`${d.name} / ${d.headline} — Quiet Compass`} description={d.description} route={project.data.route} element={project.data.element}>
<section><div class="shell"><a class="text-link" href={withBase('work/')}>← All work</a><div class="case-grid"><div><span class="route">{d.label}</span><h1>{d.name}.<br/>{d.headline}</h1><p class="lead">{d.description}</p><span class="badge">Original concept study · not client work</span></div><aside class="panel"><span class="route">At a glance</span><dl class="case-facts"><div><dt>Focus</dt><dd>{d.label}</dd></div><div><dt>Scope</dt><dd>Concept, interface, and design rationale</dd></div><div><dt>Evidence</dt><dd>Inspectable reconstructions</dd></div><div><dt>Validation</dt><dd>User research and business outcomes not measured</dd></div></dl></aside></div><nav class="case-index" aria-label="Case study sections"><a href="#story">The reasoning</a><a href="#compare">Before & after</a><a href="#artifacts">Design artifacts</a><a href="#diagram">Decision map</a></nav><ProjectMedia slug={slug} priority class="project-media hero-media" alt={`${d.name} redesigned concept showing ${d.after.join(', ')}`}/></div></section>
<section id="story"><div class="shell case-grid"><article class="prose"><Content/></article><aside class="case-aside panel"><span class="route">What you can verify here</span><p class="metric">{d.before.length} → {d.after.length}</p><p>Top-level actions in the starting and redesigned concept frames.</p><p class="notice">Fewer visible actions are not automatically better. These counts describe the artifact; they do not establish faster work, fewer errors, or higher conversion.</p><a class="text-link" href="#compare">Inspect both frames →</a></aside></div></section>
<section id="compare"><div class="shell"><div class="section-head"><div><span class="route">Transformation explorer</span><h2>Compare the decisions,<br/>not just the decoration.</h2></div><p>Drag to compare, use the Before / Compare / After buttons, or read the text explanation. Every state remains available without dragging.</p></div><Comparison slug={slug}/></div></section>
<section id="artifacts"><div class="shell"><div class="section-head"><div><span class="route">Inside the concept</span><h2>The work behind the frame.</h2></div><p>Original design maps, alternatives, and validation proposals. These artifacts make the reasoning inspectable; they are not presented as completed field research.</p></div><div class="artifact-grid">{d.artifacts.map(a=><article class="artifact"><h3>{a.title}</h3><p>{a.note}</p><ol>{a.items.map(item=><li>{item}</li>)}</ol></article>)}</div></div></section>
<section id="diagram"><div class="shell"><div class="section-head"><div><span class="route">Decision map / {d.name}</span><h2>Why this direction?</h2></div><p>Choose a decision to see its premise, the choice made, and the change it produces in this particular concept.</p></div><DecisionMap slug={slug}/></div></section>
<section class="next-action"><div class="shell section-head"><div><span class="route">A related challenge?</span><h2>Make your next question concrete.</h2></div><a class="btn primary" href={withBase(`contact/?project=${encodeURIComponent(d.name)}`)}>Prepare a project note →</a></div></section>
</BaseLayout>
